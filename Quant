<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quant</title>
    <style>
        /* Дизайн в стиле Telegram */
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto; margin: 0; background: #fff; }
        .header { background: #0088cc; color: white; padding: 15px; font-weight: bold; }
        .chat-area { height: 70vh; overflow-y: scroll; padding: 10px; }
        .message { background: #e1ffc7; padding: 10px; border-radius: 10px; margin: 5px; width: fit-content; }
        .controls { position: fixed; bottom: 0; width: 100%; display: flex; padding: 10px; background: #eee; }
        input { flex: 1; padding: 10px; border: none; border-radius: 5px; }
        button { background: #0088cc; color: white; border: none; padding: 10px; border-radius: 5px; margin-left: 5px; }
        
        /* Ночная тема */
        body.dark { background: #212121; color: white; }
        body.dark .header { background: #17212b; }
        body.dark .controls { background: #17212b; }
    </style>
</head>
<body>

<div class="header" onclick="toggleTheme()">Quant Messenger (Нажми, чтобы сменить тему)</div>
<div id="chat" class="chat-area"></div>

<div class="controls">
    <input type="text" id="msgInput" placeholder="Сообщение...">
    <button onclick="sendMessage()">Отправить</button>
</div>

<script>
    // Логика сообщений
    function sendMessage() {
        const input = document.getElementById('msgInput');
        const chat = document.getElementById('chat');
        if (input.value) {
            const div = document.createElement('div');
            div.className = 'message';
            div.innerText = input.value;
            chat.appendChild(div);
            input.value = '';
            chat.scrollTop = chat.scrollHeight; // Прокрутка вниз
        }
    }

    // Смена темы
    function toggleTheme() {
        document.body.classList.toggle('dark');
    }
</script>

</body>
</html>
